# Copy to backend/.env for local development. Never commit .env.
ENV=development
DATABASE_URL=sqlite:///./honor.db
SECRET_KEY=change-me-to-a-long-random-value-in-production
# The first parent account, created on first start if there is none.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
CORS_ORIGINS=http://localhost:5173
